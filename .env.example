# ==============================================================================
# Hybrid Quantum-Classical Vehicle Platooning — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values for your local machine.
# .env is excluded from version control via .gitignore.
# ==============================================================================

# Path to the SUMO installation root directory.
# On Linux   : /usr/share/sumo
# On Windows : C:\Program Files (x86)\Eclipse\Sumo
# On macOS   : /opt/homebrew/share/sumo
SUMO_HOME=

# Execution environment: development | testing | production
PROJECT_ENV=development
